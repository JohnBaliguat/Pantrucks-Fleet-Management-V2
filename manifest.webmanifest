{
  "id": "pantrucks-driver",
  "name": "Pantrucks Driver",
  "short_name": "PT Driver",
  "description": "Pantrucks Fleet Management — driver app for accepting jobs, updating status, capturing POD, and reporting issues.",
  "start_url": "driver-dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0d1b2a",
  "theme_color": "#0d6efd",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "navigation"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    {
      "src": "assets/images/logos/pantrucks-driver-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/images/logos/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/logos/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/logos/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/images/logos/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Pickup / POD",
      "short_name": "POD",
      "description": "Capture Proof of Delivery photos and signature.",
      "url": "driver-pod",
      "icons": [{ "src": "assets/images/logos/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Breakdown",
      "short_name": "Breakdown",
      "description": "Report a breakdown with photo and GPS.",
      "url": "driver-breakdown",
      "icons": [{ "src": "assets/images/logos/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "description": "Dispatcher messages and notifications.",
      "url": "driver-messages",
      "icons": [{ "src": "assets/images/logos/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
